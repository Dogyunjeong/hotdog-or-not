# Copy to `.env.local` (git-ignored) and fill in the values.
# All of them are server-only — never prefix them with NEXT_PUBLIC_.

# OpenAI API key used for the hotdog vision check.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=<openai-api-key>

# Supabase project URL.
# Local: http://127.0.0.1:54321 (printed by `yarn db:start`)
# Hosted: Project Settings → API → Project URL
SUPABASE_URL=http://127.0.0.1:54321

# Supabase service role key (bypasses RLS; the API is the only Supabase caller).
# Local: `yarn supabase status -o env | grep SERVICE_ROLE_KEY`
# Hosted: Project Settings → API → service_role key (or a `sb_secret_…` secret key)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Secret for the daily data retention job (`/api/cron/data-retention`, scheduled in vercel.json).
# Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`; without it the route answers 401.
# Generate: `openssl rand -hex 32`. Set it in Vercel project env vars (Production).
CRON_SECRET=<random-secret>
