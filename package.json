{
  "name": "seamflow",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "frontend/*"
    ]
  },
  "scripts": {
    "dev": "yarn workspace @seamflow/web dev",
    "build": "yarn workspace @seamflow/web build",
    "typecheck": "yarn workspaces foreach -A --exclude seamflow run typecheck",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > packages/shared-types/src/database/Database.type.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "supabase": "^2.50.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "dependenciesMeta": {
    "esbuild": {
      "built": true
    },
    "supabase": {
      "built": true
    }
  }
}
